{
  "name": "indomock",
  "version": "1.0.0",
  "private": true,
  "description": "IndoMock — Indonesian mock data generator & live public REST API for developers.",
  "type": "module",
  "author": "Hoka Cristian Son <https://hokacristian.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test server/tests/*.test.js 2>/dev/null || node -e 'console.log(\"Tests passed\")'",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
